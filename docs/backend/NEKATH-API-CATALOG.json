    "purchases": {
      "method": "GET",
      "path": "/purchases",
      "example": "nekath-api-examples/purchases.json"
    },
    "createConversation": {
      "method": "POST",
      "path": "/conversations",
      "write": true,
      "example": "nekath-api-examples/createConversation.json"
    },
    "sendMessage": {
      "method": "POST",
      "path": "/conversations/:conversationId/messages",
      "write": true,
      "example": "nekath-api-examples/sendMessage.json"
