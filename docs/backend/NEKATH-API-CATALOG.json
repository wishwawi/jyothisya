    },
    "favorites": {
      "method": "GET",
      "path": "/favorites",
      "example": "nekath-api-examples/favorites.json"
    },
    "interest": {
      "method": "POST",
      "path": "/interests",
      "write": true,
      "example": "nekath-api-examples/interest.json"
    },
    "interests": {
      "method": "GET",
      "path": "/interests",
      "example": "nekath-api-examples/interests.json"
    },
    "updateProfile": {
      "method": "PATCH",
      "path": "/profiles/:profileId",
      "write": true,
      "example": "nekath-api-examples/updateProfile.json"
    },
    "archiveProfile": {
      "method": "PATCH",
      "path": "/profiles/:profileId/archive",
      "write": true,
      "example": "nekath-api-examples/archiveProfile.json"
    }
  }
}
