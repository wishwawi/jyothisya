      "write": true,
      "example": "nekath-api-examples/removeSavedChart.json"
    },
    "createReading": {
      "method": "POST",
      "path": "/readings",
      "write": true,
      "example": "nekath-api-examples/createReading.json"
    },
    "reading": {
      "method": "GET",
      "path": "/readings/:id",
      "example": "nekath-api-examples/reading.json"
    },
    "products": {
      "method": "GET",
      "path": "/billing/products",
      "example": "nekath-api-examples/products.json"
