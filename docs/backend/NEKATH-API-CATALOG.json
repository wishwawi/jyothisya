{
  "version": "v1-proposed",
  "transport": "mock-only",
  "operations": {
    "bootstrap": {
      "method": "GET",
      "path": "/bootstrap",
      "example": "nekath-api-examples/bootstrap.json"
    },
    "places": {
      "method": "GET",
      "path": "/places",
      "example": "nekath-api-examples/places.json"
    },
    "preferences": {
      "method": "PATCH",
      "path": "/me/preferences",
      "write": true,
      "example": "nekath-api-examples/preferences.json"
    },
    "createProfile": {
      "method": "POST",
      "path": "/profiles",
      "write": true,
      "example": "nekath-api-examples/createProfile.json"
    },
    "profiles": {
      "method": "GET",
      "path": "/profiles",
      "example": "nekath-api-examples/profiles.json"
    },
    "selectProfile": {
      "method": "POST",
      "path": "/me/active-profile",
      "write": true,
      "example": "nekath-api-examples/selectProfile.json"
    },
    "home": {
      "method": "GET",
      "path": "/profiles/:profileId/home",
      "example": "nekath-api-examples/home.json"
    },
    "chart": {
      "method": "GET",
      "path": "/profiles/:profileId/charts/:kind",
      "example": "nekath-api-examples/chart.json"
