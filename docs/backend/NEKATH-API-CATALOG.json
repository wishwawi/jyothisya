    },
    "submitVerification": {
      "method": "POST",
      "path": "/me/verification",
      "write": true,
      "example": "nekath-api-examples/submitVerification.json"
    },
    "verification": {
      "method": "GET",
      "path": "/me/verification",
      "example": "nekath-api-examples/verification.json"
    },
    "matches": {
      "method": "GET",
      "path": "/matches",
      "example": "nekath-api-examples/matches.json"
    },
    "match": {
      "method": "GET",
      "path": "/matches/:id",
      "example": "nekath-api-examples/match.json"
